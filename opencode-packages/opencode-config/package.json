{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "opencode-config",
  "version": "0.1.0",
  "description": "OpenCode TUI controls for managing skills in local and global configuration",
  "type": "module",
  "files": [
    "src",
    "tui",
    "README.md",
    "docs"
  ],
  "exports": {
    ".": {
      "import": "./src/index.ts"
    },
    "./tui": {
      "import": "./tui/tui.tsx"
    }
  },
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@opencode-ai/plugin": "beta",
    "jsonc-parser": "3.3.1"
  },
  "devDependencies": {
    "@opentui/core": "^0.5.6",
    "@opentui/solid": "^0.5.6",
    "@types/node": "^24.12.2",
    "bun-types": "^1.3.13",
    "solid-js": "^1.9.10",
    "typescript": "^5.8.2"
  },
  "keywords": [
    "opencode",
    "plugin",
    "skills",
    "configuration",
    "tui"
  ],
  "license": "MIT"
}
