{
  "$schema": "https://opencode.ai/config.json",
  "agent": {
    "high": {
      "color": "#ff8080",
      "model": "github-copilot/gpt-5.6-sol",
      "variant": "medium"
    },
    "low": {
      "color": "#ffc799",
      "model": "github-copilot/gpt-5.6-luna",
      "variant": "high"
    },
    "plan": {
      "hidden": true
    }
  },
  "default_agent": "low",
  "mcp": {
    "atlassian": {
      "enabled": true,
      "type": "remote",
      "url": "https://mcp.atlassian.com/v1/mcp/authv2"
    },
    "codesearch": {
      "command": [
        "/opt/homebrew/bin/codesearch",
        "mcp"
      ],
      "cwd": "/opt/homebrew/bin",
      "enabled": true,
      "type": "local"
    },
    "datadog": {
      "enabled": true,
      "type": "remote",
      "url": "https://mcp.datadoghq.eu/api/unstable/mcp-server/mcp?toolsets=all"
    },
    "filesystem": {
      "command": [
        "mcp-server-filesystem",
      ],
      "enabled": true,
      "type": "local"
    },
    "github": {
      "type": "remote",
      "url": "https://api.githubcopilot.com/mcp/x/all",
      "enabled": false,
      "oauth": false,
      "headers": {
        "Authorization": "Bearer {env:GITHUB_TOKEN}"
      }
    },
    "incidentio": {
      "enabled": true,
      "type": "remote",
      "url": "https://mcp.incident.io/mcp"
    },
    "kubernetes": {
      "command": [
        "kubernetes-mcp-server",
      ],
      "enabled": true,
      "type": "local"
    },
  },
  "permission": {
    "skill": {
      "*": "deny",
      "boxed-infra": "allow",
      "diagnosing-bugs": "allow",
      "domain-modeling": "allow",
      "grilling": "allow",
      "implement-code": "allow",
      "opencode": "allow",
      "terminal-control": "allow",
      "report": "allow",
      "tdd": "allow",
      "write-discoverable-code": "allow",
      "writing-for-agents": "allow"
    },
    "task": {
      "*": "deny"
    },
    "todowrite": "deny"
  },
  "plugin": [
    "/Users/stephen.collings/workspace/github.com/eeveebank/nwb/opencode-plugins/v2/dist/boxedcode.js"
  ],
  "references": {
    "opencode-v2": {
      "branch": "v2",
      "description": "Use for opencode v2 source",
      "repository": "anomalyco/opencode"
    }
  },
  "skills": {
    "paths": [
      "~/.github/skills",
      ".github/skills"
    ]
  }
}
