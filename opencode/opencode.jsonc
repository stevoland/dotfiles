{
  "$schema": "https://opencode.ai/config.json",
  "agent": {
    "low": {
      "color": "#ffc799",
      "model": "github-copilot/gpt-5.6-luna",
      "variant": "high",
      "prompt": "{file:./prompts/default.md}"
    },
    "high": {
      "color": "#ff8080",
      "model": "github-copilot/gpt-5.6-sol",
      "variant": "medium",
      "prompt": "{file:./prompts/default.md}"
    },
    "build": {
      "task": "allow"
    },
    "plan": {
      "hidden": true
    },
    "babysitter": {
      "model": "github-copilot/gpt-5.6-sol",
      "variant": "medium",
      "permission": {
        "skill": {
          "babysit": "allow",
          "review-amends": "allow"
        }
      },
      "prompt": "Immediately invoke the `babysit` skill and follow the instructions."
    },
    "reviewer": {
      "model": "github-copilot/gpt-5.6-sol",
      "variant": "medium",
      "mode": "all",
      "prompt": "Immediately invoke the `code-review` skill and follow the instructions."
    },
  },
  "default_agent": "low",
  "mcp": {
    "atlassian": {
      "enabled": true,
      "type": "remote",
      "url": "https://mcp.atlassian.com/v1/mcp"
    },
    "codesearch": {
      "command": [
        "/opt/homebrew/bin/codesearch",
        "mcp"
      ],
      "cwd": "/opt/homebrew/bin",
      "enabled": true,
      "type": "local"
    },
    "datadog": {
      "enabled": true,
      "type": "remote",
      "url": "https://mcp.datadoghq.eu/api/unstable/mcp-server/mcp?toolsets=all"
    },
    "filesystem": {
      "command": [
        "mcp-server-filesystem",
      ],
      "enabled": true,
      "type": "local"
    },
    "github": {
      "type": "remote",
      "url": "https://api.githubcopilot.com/mcp",
      "enabled": true,
      "oauth": false,
      "headers": {
        "Authorization": "Bearer {env:GITHUB_TOKEN}"
      }
    },
    "incidentio": {
      "enabled": true,
      "type": "remote",
      "url": "https://mcp.incident.io/mcp"
    },
    "kubernetes": {
      "command": [
        "node", "/Users/stephen.collings/workspace/github.com/eeveebank/boxed-mcp-servers/boxed-kubernetes-mcp-server/dist/index.js",
      ],
      "environment": {
        "KUBECONFIG": "/Users/stephen.collings/.kube/boxed-config.yaml"
      },
      "enabled": true,
      "type": "local"
    },
  },
  "permission": {
    "skill": {
      "*": "deny",
      "boxed-infra": "allow",
      "code-review": "allow",
      "diagnosing-bugs": "allow",
      "documentation-and-adrs": "allow",
      "domain-modeling": "allow",
      "grilling": "allow",
      "implement-code": "allow",
      "opencode": "allow",
      "terminal-control": "allow",
      "report": "allow",
      "tdd": "allow",
      "write-discoverable-code": "allow",
      "writing-for-agents": "allow"
    },
    "task": {
      "*": "deny",
      "reviewer": "allow"
    },
    "todowrite": "deny"
  },
  "plugin": [
    "/Users/stephen.collings/workspace/github.com/eeveebank/nwb/opencode-plugins/v2/dist/boxedcode.js"
  ],
  "references": {
    "opencode-v2": {
      "branch": "v2",
      "description": "Use for opencode v2 source",
      "repository": "anomalyco/opencode"
    }
  },
  "skills": {
    "paths": [
      "~/.github/skills",
      ".github/skills"
    ]
  }
}
