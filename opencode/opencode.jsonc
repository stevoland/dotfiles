{
  "$schema": "https://opencode.ai/config.json",
  "agent": {
    "babysitter": {
      "model": "github-copilot/gpt-5.6-sol",
      "permission": {
        "skill": {
          "babysit": "allow",
          "review-amends": "allow"
        }
      },
      "prompt": "Immediately invoke the `babysit` skill and follow the instructions.",
      "variant": "medium"
    },
    "build": {
      "hidden": true
    },
    "explore": {
      "model": "github-copilot/gpt-5.6-luna",
      "variant": "high"
    },
    "general": {
      "model": "github-copilot/gpt-5.6-luna",
      "variant": "high"
    },
    "high": {
      "color": "#ff8080",
      "model": "github-copilot/gpt-5.6-sol",
      "prompt": "{file:./prompts/default.md}",
      "variant": "medium"
    },
    "low": {
      "color": "#ffc799",
      "model": "github-copilot/gpt-5.6-luna",
      "variant": "high"
    },
    "oracle": {
      "description": "Consult a read-only oracle for deep analysis, code review, debugging, planning, and second opinions. Use oracle sparingly when you want a second opinion, deeper analysis, code review, debugging help, or a higher-reasoning pass. Do not use oracle for routine low-value work; oracle is slower than the main agent. Include enough context for a stand-alone review or analysis.",
      "mode": "subagent",
      "model": "github-copilot/gpt-6-astra",
      "permission": {
        "edit": "deny"
      },
      "prompt": "{file:./prompts/oracle.md}",
      "variant": "med"
    },
    "plan": {
      "hidden": true
    },
    "reviewer": {
      "mode": "all",
      "model": "github-copilot/gpt-5.6-sol",
      "prompt": "Immediately invoke the `code-review` skill and follow the instructions.",
      "variant": "medium"
    }
  },
  "default_agent": "low",
  "mcp": {
    "agent-browser": {
      "command": [
        "agent-browser",
        "mcp",
        "--tools",
        "all"
      ],
      "enabled": true,
      "type": "local"
    },
    "atlassian": {
      "enabled": true,
      "type": "remote",
      "url": "https://mcp.atlassian.com/v1/mcp"
    },
    "codesearch": {
      "command": [
        "/opt/homebrew/bin/codesearch",
        "mcp"
      ],
      "cwd": "/opt/homebrew/bin",
      "enabled": true,
      "type": "local"
    },
    "datadog": {
      "enabled": true,
      "type": "remote",
      "url": "https://mcp.datadoghq.eu/api/unstable/mcp-server/mcp?toolsets=all"
    },
    "filesystem": {
      "command": [
        "mcp-server-filesystem"
      ],
      "enabled": true,
      "type": "local"
    },
    "github": {
      "enabled": false,
      "headers": {
        "Authorization": "Bearer {env:GITHUB_TOKEN}"
      },
      "oauth": false,
      "type": "remote",
      "url": "https://api.githubcopilot.com/mcp"
    },
    "incidentio": {
      "enabled": true,
      "type": "remote",
      "url": "https://mcp.incident.io/mcp"
    },
    "kubernetes": {
      "command": [
        "node",
        "/Users/stephen.collings/workspace/github.com/eeveebank/boxed-mcp-servers/boxed-kubernetes-mcp-server/dist/index.js"
      ],
      "enabled": true,
      "environment": {
        "KUBECONFIG": "/Users/stephen.collings/.kube/boxed-config.yaml"
      },
      "type": "local"
    }
  },
  "permission": {
    "skill": {
      "*": "deny",
      "adr": "allow",
      "agents-md": "allow",
      "boxed-platform": "allow",
      "code-review": "allow",
      "codebase-design": "allow",
      "coding-standards": "allow",
      "diagnosing-bugs": "allow",
      "documentation-and-adrs": "allow",
      "domain-modeling": "allow",
      "grilling": "allow",
      "implement-code": "allow",
      "opencode": "allow",
      "prototype": "allow",
      "report": "allow",
      "tdd": "allow",
      "terminal-control": "allow",
      "wayfinder": "allow",
      "write-discoverable-code": "allow",
      "writing-for-agents": "allow"
    },
    "todowrite": "deny"
  },
  "plugin": [
    "/Users/stephen.collings/dotfiles/opencode-packages/opencode-babysit/src",
    "/Users/stephen.collings/dotfiles/opencode-packages/opencode-rift/src",
    "/Users/stephen.collings/dotfiles/opencode-packages/opencode-gemini/src",
    "/Users/stephen.collings/dotfiles/opencode-packages/opencode-trajectory/src",
    "/Users/stephen.collings/.boxedcode-pro/0.16.1/boxedcode-pro"
  ],
  "provider": {
    "github-copilot": {
      "models": {
        "gpt-6-astra": {
          "limit": {
            "context": 400000,
            "input": 272000,
            "output": 128000
          },
          "name": "GPT-6 Astra (Astranomical ha!)"
        }
      }
    }
  },
  "references": {
    "opencode-v2": {
      "branch": "v2",
      "description": "Use for opencode v2 source",
      "repository": "anomalyco/opencode"
    }
  },
  "shell": "/opt/homebrew/bin/opencode-shell",
  "skills": {
    "paths": [
      "~/.github/skills",
      ".github/skills"
    ]
  }
}
